# Copy to .env for local development (.env is gitignored).
# In production (Render) set these under Service -> Environment instead.

# SQLAlchemy database URL. PostgreSQL in production; SQLite works locally.
DATABASE_URL=sqlite:///./products.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign JWT access tokens (any long random string for local development)
SECRET_KEY=replace-with-a-long-random-string

# Optional (defaults shown)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
